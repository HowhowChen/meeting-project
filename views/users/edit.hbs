<form novalidate id="form" action="/users/{{ user.id }}?_method=PUT" method="POST">
  <div class="row mt-5">
      <div class="">
        <div class="row align-items-center mb-5">
          <div class="col-3 text-danger">
            *Required Input
          </div>
          <h1 class="col-9 text-center text-secondary">
            Edit User
          </h1>
        </div>

        {{> messages}}
        
        <div class="row align-items-center mb-5 h3">
          <label for="name" class="col-3 text-white"><span class="text-danger">*</span>Name:</label>
          <div class="col-9">
            <input id="name" name="name" type="text" class="form-control" value="{{ user.name }}" disabled>
              <div class="valid-feedback">Good!</div>
              <div class="invalid-feedback">This field is required</div>
          </div>
        </div>

        <div class="row align-items-center mb-5 h3">
          <label for="account" class="col-3 text-white"><span class="text-danger">*</span>Account:</label>
          <div class="col-9">
            <input id="account" name="account" type="text" class="form-control" value="{{ user.account }}" disabled>
              <div class="valid-feedback">Good!</div>
              <div class="invalid-feedback">This field is required</div>
          </div>
        </div>

        <div class="row align-items-center mb-5 h3">
          <label for="password" class="col-3 text-white"><span class="text-danger">*</span>Password:</label>
          <div class="col-9">
            <input id="password" name="password" type="password" class="form-control" value="" required>
              <div class="valid-feedback">Good!</div>
              <div class="invalid-feedback">This field is required</div>
          </div>
        </div>

        <div class="row align-items-center mb-5 h3">
          <label for="passwordCheck" class="col-3 text-white"><span class="text-danger">*</span>Password Check:</label>
          <div class="col-9">
            <input id="passwordCheck" name="passwordCheck" type="password" class="form-control" value="" required>
              <div class="valid-feedback">Good!</div>
              <div class="invalid-feedback">This field is required</div>
          </div>
        </div>
        
        <div class="row align-items-center mb-5 h3">
          <div class="col-3 ">
            <a class="btn btn-outline-success" href="javascript:history.back()">🔙back to previous page</a>
          </div>
          <div class="col-9">
            <div class="d-flex justify-content-center">
              <button type="reset" class="btn btn-danger">重設</button>&nbsp
              <button id="submitButton" type="submit" class="btn btn-primary">送出</button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</form>