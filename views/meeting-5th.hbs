<form novalidate id="form" action="/meetings/5th/{{ meeting.id }}?_method=PUT" method="POST">
  <div class="row mt-5">
    <div class="">
      <div class="row align-items-center mb-5">
        <div class="col-3 text-danger">
          *Required Input
        </div>
        <h1 class="col-9 text-center text-secondary">
          Edit Meeting
        </h1>
      </div>

      {{> messages}}
      
      <div class="row align-items-center mb-5 h3">
        <label for="name" class="col-3 text-white">會議主旨:</label>
        <div class="col-9">
          <input id="content" name="name" type="text" class="form-control" value="{{ meeting.name }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="content" class="col-3 text-white">會議內容:</label>
        <div class="col-9">
          <textarea class="form-control" id="content" name="content" rows="3">{{ meeting.content }}</textarea>
        </div>
      </div>
      
      <div class="row align-items-center mb-5 h3">
        <label for="organization" class="col-3 text-white">會議單位:</label>
        <div class="col-9">
          <input id="organization" name="organization" type="text" class="form-control" value="{{ meeting.organization }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="sender" class="col-3 text-white">寄件者:</label>
        <div class="col-9">
          <input id="sender" name="sender" type="text" class="form-control" value="{{ meeting.sender }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="receiver" class="col-3 text-white">收件者:</label>
        <div class="col-9">
          <textarea class="form-control" id="receiver" name="receiver" rows="3">{{ meeting.receiver }}</textarea>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="meetingDate" class="col-3 text-white">會議日期:</label>
        <div class="col-9">
          <input id="meetingDate" name="meetingDate" type="date" class="form-control" value="{{ meeting.meeting_date }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="acceptanceDate" class="col-3 text-white">來料日期:</label>
        <div class="col-9">
          <input id="acceptanceDate" name="acceptanceDate" type="date" class="form-control" value="{{ meeting.acceptance_date }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="importDate" class="col-3 text-white">入庫日期:</label>
        <div class="col-9">
          <input id="importDate" name="importDate" type="date" class="form-control" value="{{ meeting.import_date }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="exportDate" class="col-3 text-white">報局日期:</label>
        <div class="col-9">
          <input id="exportDate" name="exportDate" type="date" class="form-control" value="{{ meeting.export_date }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="link" class="col-3 text-white">會議連結:</label>
        <div class="col-9">
          <input id="link" name="link" type="text" class="form-control" value="{{ meeting.link }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="password" class="col-3 text-white">會議ID\密碼:</label>
        <div class="col-9">
          <input id="password" name="password" type="text" class="form-control" value="{{ meeting.password }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="fileName" class="col-3 text-white">原件名稱:</label>
        <div class="col-9">
          <input id="fileName" name="fileName" type="text" class="form-control" value="{{ meeting.file_name }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="category" class="col-3 text-white"><span class="text-danger">*</span>會議類型:</label>
        <div class="col-9">
          <select id="category" name="category" list="categories" class="form-control"  required>
            {{#each categories}}
              <option value="{{this.id}}" {{#ifMatch this.name ../meeting.category_name}}selected{{/ifMatch}}>{{this.name}}</option>
            {{/each}}
          </select>
          <div class="valid-feedback">Good!</div>
          <div class="invalid-feedback">This field is required</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="platform" class="col-3 text-white"><span class="text-danger">*</span>會議平台:</label>
        <div class="col-9">
          <select id="platform" name="platform" list="platfroms" class="form-control"  required>
            {{#each platforms}}
              <option value="{{this.id}}" {{#ifMatch this.name ../meeting.platform_name}}selected{{/ifMatch}}>{{this.name}}</option>
            {{/each}}
          </select>
          <div class="valid-feedback">Good!</div>
          <div class="invalid-feedback">This field is required</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="country" class="col-3 text-white"><span class="text-danger">*</span>國別:</label>
        <div class="col-9">
          <select id="country" name="country" list="countries" class="form-control"  required>
            {{#each countries}}
              <option value="{{this.id}}" {{#ifMatch this.name ../meeting.country_name}}selected{{/ifMatch}}>{{this.name}}</option>
            {{/each}}
          </select>
          <div class="valid-feedback">Good!</div>
          <div class="invalid-feedback">This field is required</div>
        </div>
      </div>

      {{!-- <div class="row align-items-center mb-5 h3">
        <label for="issue" class="col-3 text-white">Issue:</label>
        <div class="col-9">
          <select id="country" name="issueId" list="issues" class="form-control"  required>
            {{#each issues}}
              <option value="{{this.id}}" {{#ifMatch this.id ../meeting.MeetingIssues.Issue.id}}selected{{/ifMatch}}>{{this.name}}</option>
            {{/each}}
          </select> 
        </div>
      </div> --}}

      <div class="row align-items-center mb-5 h3">
        <label for="uuid" class="col-3 text-white">報號/來源:</label>
        <div class="col-9">
          <input id="uuid" name="uuid" type="text" class="form-control" value="{{ meeting.uuid }}">
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="comment" class="col-3 text-white">備註(符合情蒐):</label>
        <div class="col-9">
          <textarea class="form-control" id="comment" name="comment" rows="3">{{ meeting.comment_content_5th }}</textarea>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="issue" class="col-3 text-white">Issue:</label>
        <div class="col-9">
          <input type="hidden" id="issueId" name="issueId">
          <input list="issue-category" id="issue" value="{{meeting.issue_name}}">
          <span id="issue-message"></span>
          <datalist id="issue-category">
            {{#each issues}}
              <option value="{{this.name}}" data-value="{{this.id}}">{{this.name}}</option>
            {{/each}}
          </datalist>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <div class="col-3 ">
          <a class="btn btn-outline-success" href="javascript:history.back()">🔙上一頁</a>
        </div>
        <div class="col-9">
          <div class="d-flex justify-content-center">
            <button type="reset" class="btn btn-danger">重設</button>&nbsp
            <button id="submitButton" type="submit" class="btn btn-primary">送出</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</form>
