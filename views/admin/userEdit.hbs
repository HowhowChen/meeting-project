<form novalidate id="form" action="/records/new" method="POST">
  <div class="row mt-5">
      <div class="">
        <div class="row align-items-center mb-5">
          <div class="col-3 text-danger">
            *Required Input
          </div>
          <h1 class="col-9 text-center text-secondary">
            Add New User
          </h1>
        </div>

        {{!-- {{> message}} --}}
        
        <div class="row align-items-center mb-5 h3">
          <label for="name" class="col-3 text-white"><span class="text-danger">*</span>Name:</label>
          <div class="col-9">
            <input id="name" name="name" type="text" class="form-control" value="{{ user.name }}" required>
              <div class="valid-feedback">Good!</div>
              <div class="invalid-feedback">This field is required</div>
          </div>
        </div>

        <div class="row align-items-center mb-5 h3">
          <label for="account" class="col-3 text-white"><span class="text-danger">*</span>Account:</label>
          <div class="col-9">
            <input id="account" name="account" type="text" class="form-control" value="{{ user.account }}" required>
              <div class="valid-feedback">Good!</div>
              <div class="invalid-feedback">This field is required</div>
          </div>
        </div>


        <div class="row align-items-center mb-5 h3">
          <label for="organization" class="col-3 text-white"><span class="text-danger">*</span>Organization:</label>
          <div class="col-9">
            <select id="organization" name="organization" list="organizations" class="form-control"  required>
              <option {{#ifMatch user.organization 'the 5 class'}}selected{{/ifMatch}}>the 5 class</option>
              <option {{#ifMatch user.organization 'the 6 class'}}selected{{/ifMatch}}>the 6 class</option>
            </select>
            <div class="valid-feedback">Good!</div>
            <div class="invalid-feedback">This field is required</div>
          </div>
        </div>

        <div class="row align-items-center mb-5 h3">
          <label for="group" class="col-3 text-white"><span class="text-danger">*</span>Group:</label>
          <div class="col-9">
            <select id="group" name="group" list="groups" class="form-control"  required>
              <option {{#ifMatch user.group '5th'}}selected{{/ifMatch}}>5th</option>
              <option {{#ifMatch user.group '6th'}}selected{{/ifMatch}}>6th</option>
            </select>
            <div class="valid-feedback">Good!</div>
            <div class="invalid-feedback">This field is required</div>
          </div>
        </div>

        <div class="row align-items-center mb-5 h3">
          <label for="role" class="col-3 text-white"><span class="text-danger">*</span>Role:</label>
          <div class="col-9">
            <select id="role" name="role" list="roles" class="form-control"  required>
              <option {{#ifMatch user.role 'user'}}selected{{/ifMatch}}>user</option>
              <option {{#ifMatch user.role 'admin'}}selected{{/ifMatch}}>admin</option>
            </select>
            <div class="valid-feedback">Good!</div>
            <div class="invalid-feedback">This field is required</div>
          </div>
        </div>
          
        <div class="d-flex justify-content-center">
          <button type="reset" class="btn btn-danger">重設</button>&nbsp
          <button id="submitButton" type="submit" class="btn btn-primary">送出</button>
        </div>

      </div>
    </div>
  </div>
</form>