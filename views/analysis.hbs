{{> meeting-5th-tabs route="analysis" }}
{{> search-analysis}}

<div class="mx-auto" style="width:90%;">
	{{> messages}}
</div>

<div class="text-primary text-secondary text-end mb-1 mx-auto fs-5" style="width:90%;">
    頁數<span id="current-page">{{pagination.currentPage}}</span>/{{pagination.totalPage}}
</div>

<table class="table-5th table-striped">
	<thead>
		<tr>
			<th><h1>國別</h1></th>
			<th><h1>電郵總數</h1></th>
      <th><h1>電郵總數_{{sender}}</h1></th>
			<th><h1>Zoom</h1></th>
      <th><h1>Zoom_{{sender}}</h1></th>
      <th><h1>Webex</h1></th>
      <th><h1>Webex_{{sender}}</h1></th>
      <th><h1>Tencent</h1></th>
      <th><h1>Tencent_{{sender}}</h1></th>
		</tr>
	</thead>
	<tbody>
		{{#each meetings}}
			<tr>
				<td class="AutoNewline">{{this.country_name}}</td>
				<td class="AutoNewline">{{this.total}}</td>
        <td class="AutoNewline">{{this.total_specify}}</td>
        <td class="AutoNewline">{{this.zoom}}</td>
        <td class="AutoNewline">{{this.zoom_specify}}</td>
        <td class="AutoNewline">{{this.webex}}</td>
        <td class="AutoNewline">{{this.webex_specify}}</td>
        <td class="AutoNewline">{{this.tencent}}</td>
        <td class="AutoNewline">{{this.tencent_specify}}</td>
			</tr>
		{{/each}}
	</tbody>
</table>

{{#if pagination.pages}}
	<nav class="mt-5 d-flex justify-content-center fs-4 " aria-label="page navigation">
		<ul class="pagination">
			<li class="page-item {{#ifMatch pagination.currentPage 1}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/5th/analysis?page={{pagination.prev}}&startDate={{startDate}}&endDate={{endDate}}&sender={{sender}}" aria-label="Previous">
					<span aria-hidden="true">&laquo;</span>
				</a>
			</li>
			{{#each pagination.pages}}
				{{#ifMatch this.page  ../pagination.currentPage}}
					<li class="page-item active"><a class="page-link" href="#">{{this.page }}</a></li>
				{{else}}
					<li class="page-item">
						<a class="page-link" href="/meetings/5th/analysis?page={{this.page }}&startDate={{../startDate}}&endDate={{../endDate}}&sender={{../sender}}">{{this.page }}</a>
					</li>
				{{/ifMatch}}
			{{/each}}
			<li class="page-item {{#ifMatch pagination.currentPage pagination.totalPage}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/5th/analysis?page={{pagination.next}}&startDate={{startDate}}&endDate={{endDate}}&sender={{sender}}" aria-label="Next">
					<span aria-hidden="true">&raquo;</span>
				</a>
			</li>
		</ul>
	</nav>
{{/if}}