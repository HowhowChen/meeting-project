{{> meeting-tabs route="index" }}
{{> search-5th}}
<div class="mx-auto" style="width:90%;">
	{{> messages}}
</div>

<div class="text-primary text-secondary text-end mb-1 mx-auto fs-5" style="width:90%;">
    頁數<span id="current-page">{{pagination.currentPage}}</span>/{{pagination.totalPage}}
</div>

<table class="table-5th table-striped">
	<thead>
		<tr>
			<th><h1>Name</h1></th>
			<th><h1>Platform</h1></th>
			<th><h1>Category</h1></th>
			<th><h1>Country</h1></th>
			<th><h1>Organization</h1></th>
			<th><h1>Meeting Date</h1></th>
			<th><h1>Acceptance Date</h1></th>
			<th><h1>Sender</h1></th>
			<th><h1>Receiver</h1></th>
			<th><h1>Link<h1></th>
			<th><h1>Password</h1></th>
			<th><h1>Value</h1></th>
			<th><h1>Download</h1></th>
		</tr>
	</thead>
	<tbody>
		{{#each meetings}}
			<tr>
				<td class="AutoNewline">{{this.name}}</td>
				<td class="AutoNewline">{{this.Platform.name}}</td>
				<td class="AutoNewline">{{this.Category.name}}</td>
				<td class="AutoNewline">{{this.Country.name}}</td>
				<td class="AutoNewline">{{this.organization}}</td>
				<td class="AutoNewline">{{this.meetingDate}}</td>
				<td class="AutoNewline">{{this.acceptanceDate}}</td>
				<td class="AutoNewline">{{this.sender}}</td>
				<td class="AutoNewline">{{this.receiver}}</td>
				<td class="AutoNewline">{{this.link}}</td>
				<td class="AutoNewline">{{this.password}}</td>
				<td class="AutoNewline">
					{{#ifMatch this.value true}}V{{/ifMatch}}
				</td>
				<td class="AutoNewline">
					<a href="/meetings/files/{{this.acceptanceDate}}/{{this.fileName}}" target="_blank">file</a>
				</td>
			</tr>
		{{/each}}
	</tbody>
</table>

{{#if pagination.pages}}
	<nav class="mt-5 d-flex justify-content-center fs-4 " aria-label="page navigation">
		<ul class="pagination">
			<li class="page-item {{#ifMatch pagination.currentPage 1}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/5th?page={{pagination.prev}}&categoryId={{categoryId}}&platformId={{platformId}}&countryId={{countryId}}&startDate={{startDate}}&endDate={{endDate}}" aria-label="Previous">
					<span aria-hidden="true">&laquo;</span>
				</a>
			</li>
			{{#each pagination.pages}}
				{{#ifMatch this.page  ../pagination.currentPage}}
					<li class="page-item active"><a class="page-link" href="#">{{this.page }}</a></li>
				{{else}}
					<li class="page-item">
						<a class="page-link" href="/meetings/5th?page={{this.page }}&categoryId={{../categoryId}}&platformId={{../platformId}}&countryId={{../countryId}}&startDate={{../startDate}}&endDate={{../endDate}}">{{this.page }}</a>
					</li>
				{{/ifMatch}}
			{{/each}}
			<li class="page-item {{#ifMatch pagination.currentPage pagination.totalPage}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/5th?page={{pagination.next}}&categoryId={{categoryId}}&platformId={{platformId}}&countryId={{countryId}}&startDate={{startDate}}&endDate={{endDate}}" aria-label="Next">
					<span aria-hidden="true">&raquo;</span>
				</a>
			</li>
		</ul>
	</nav>
{{/if}}