{{> meeting-5th-tabs route="index" }}
{{> search-5th}}
<div class="mx-auto" style="width:90%;">
	{{> messages}}
</div>

<div class="text-primary text-secondary text-end mb-1 mx-auto fs-5" style="width:90%;">
    頁數<span id="current-page">{{pagination.currentPage}}</span>/{{pagination.totalPage}}
</div>

<table class="table-5th table-striped">
	<thead>
		<tr>
			<th><h1>已蒐錄會議紀錄</h1></th>
			<th><h1>具產情價值</h1></th>
			<th><h1>來料日期</h1></th>
			<th><h1>會議日期</h1></th>
			<th><h1>會議平台</h1></th>
			<th><h1>會議主旨</h1></th>
			<th><h1>會議單位</h1></th>
			<th><h1>會議連結</h1></th>
			<th><h1>會議ID/密碼</h1></th>
			<th><h1>原件下載</h1></th>
			<th><h1>編輯</h1></th>
		</tr>
	</thead>
	<tbody>
		{{#each meetings}}
			<tr>
				<td class="AutoNewline text-center">
					{{#ifMatch this.is_done true}}V{{/ifMatch}}
				</td>
				<td class="AutoNewline text-center">
					{{#ifMatch this.is_value true}}V{{/ifMatch}}
				</td>
				<td class="AutoNewline">{{this.acceptance_date}}</td>
				<td class="AutoNewline">{{this.meeting_date}}</td>
				<td class="AutoNewline">{{this.platform_name}}</td>
				<td class="AutoNewline">{{this.name}}</td>
				<td class="AutoNewline">{{this.organization}}</td>
				<td class="AutoNewline">{{this.link}}</td>
				<td class="AutoNewline">{{this.password}}</td>
				<td class="AutoNewline">
					<a class="btn btn-outline-info" href="/meetings/files/{{this.acceptance_date}}/{{this.file_name}}" target="_blank">📧Download</a>
				</td>
				<td class="AutoNewline">
					<a class="btn btn-outline-warning" href="/meetings/5th/{{this.id}}">✍Edit</a>
				</td>
			</tr>
		{{/each}}
	</tbody>
</table>

{{#if pagination.pages}}
	<nav class="mt-5 d-flex justify-content-center fs-4 " aria-label="page navigation">
		<ul class="pagination">
			<li class="page-item {{#ifMatch pagination.currentPage 1}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/5th?page={{pagination.prev}}&categoryId={{categoryId}}&platformId={{platformId}}&countryId={{countryId}}&startDate={{startDate}}&endDate={{endDate}}&selectDateType={{selectDateType}}" aria-label="Previous">
					<span aria-hidden="true">&laquo;</span>
				</a>
			</li>
			{{#each pagination.pages}}
				{{#ifMatch this.page  ../pagination.currentPage}}
					<li class="page-item active"><a class="page-link" href="#">{{this.page }}</a></li>
				{{else}}
					<li class="page-item">
						<a class="page-link" href="/meetings/5th?page={{this.page }}&categoryId={{../categoryId}}&platformId={{../platformId}}&countryId={{../countryId}}&startDate={{../startDate}}&endDate={{../endDate}}&selectDateType={{../selectDateType}}">{{this.page }}</a>
					</li>
				{{/ifMatch}}
			{{/each}}
			<li class="page-item {{#ifMatch pagination.currentPage pagination.totalPage}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/5th?page={{pagination.next}}&categoryId={{categoryId}}&platformId={{platformId}}&countryId={{countryId}}&startDate={{startDate}}&endDate={{endDate}}&selectDateType={{selectDateType}}" aria-label="Next">
					<span aria-hidden="true">&raquo;</span>
				</a>
			</li>
		</ul>
	</nav>
{{/if}}