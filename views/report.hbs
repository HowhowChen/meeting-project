{{> meeting-5th-tabs route="report" }}
{{> search-report}}

<div class="text-primary text-secondary text-end mb-1 mx-auto fs-5" style="width:90%;">
    頁數<span id="current-page">{{pagination.currentPage}}</span>/{{pagination.totalPage}}
</div>

<table class="table-5th table-striped">
	<thead>
		<tr>
			<th><h1>入庫日期</h1></th>
			<th><h1>來料日期</h1></th>
			<th><h1>會議日期</h1></th>
			<th><h1>國別</h1></th>
			<th><h1>會議平台</h1></th>
			<th><h1>會議主旨</h1></th>
			<th><h1>會議單位</h1></th>
			<th><h1>第六組評選</h1></th>
			<th><h1>報局日期</h1></th>
			<th><h1>科情編號</h1></th>
			<th><h1>第五組評論</h1></th>
			<th><h1>第六組評論</h1></th>
		</tr>
	</thead>
	<tbody>
		{{#each meetings}}
			<tr>
				<td class="AutoNewline">{{this.import_date}}</td>
				<td class="AutoNewline">{{this.acceptance_date}}</td>
				<td class="AutoNewline">{{this.meeting_date}}</td>
				<td class="AutoNewline">{{this.country_name}}</td>
				<td class="AutoNewline">{{this.platform_name}}</td>
				<td class="AutoNewline">{{this.name}}</td>
				<td class="AutoNewline">{{this.organization}}</td>
				<td class="AutoNewline">
					{{#ifMatch this.is_value true}}V{{/ifMatch}}
				</td>
				<td class="AutoNewline">{{this.export_date}}</td>
				<td class="AutoNewLine">{{this.uuid}}</td>
				<td class="AutoNewline">{{this.comment_content_5th}}</td>
				<td class="AutoNewline">{{this.comment_content_6th}}</td>
			</tr>
		{{/each}}
	</tbody>
</table>

{{#if pagination.pages}}
	<nav class="mt-5 d-flex justify-content-center fs-4 " aria-label="page navigation">
		<ul class="pagination">
			<li class="page-item {{#ifMatch pagination.currentPage 1}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/5th/report?page={{pagination.prev}}&startDate={{startDate}}&endDate={{endDate}}" aria-label="Previous">
					<span aria-hidden="true">&laquo;</span>
				</a>
			</li>
			{{#each pagination.pages}}
				{{#ifMatch this.page  ../pagination.currentPage}}
					<li class="page-item active"><a class="page-link" href="#">{{this.page }}</a></li>
				{{else}}
					<li class="page-item">
						<a class="page-link" href="/meetings/5th/report?page={{this.page }}&startDate={{../startDate}}&endDate={{../endDate}}">{{this.page }}</a>
					</li>
				{{/ifMatch}}
			{{/each}}
			<li class="page-item {{#ifMatch pagination.currentPage pagination.totalPage}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/5th/report?page={{pagination.next}}&startDate={{startDate}}&endDate={{endDate}}" aria-label="Next">
					<span aria-hidden="true">&raquo;</span>
				</a>
			</li>
		</ul>
	</nav>
{{/if}}