{{> meeting-6th-tabs route="issue" }}
{{!-- {{> search-6th}} --}}
<div class="mx-auto" style="width:90%;">
	{{> messages}}
</div>

<table class="table-5th table-striped">
	<thead>
		<tr>
			<th><h1>會議日期</h1></th>
			<th><h1>併報主旨</h1></th>
			<th><h1>併報內容</h1></th>
		</tr>
	</thead>
	<tbody>
		{{#each issues}}
			<tr>
				<td class="AutoNewline">{{this.meeting_date}}</td>
				<td class="AutoNewline">{{this.name}}</td>
				<td class="AutoNewline">
          <a class="btn btn-outline-warning" href="/meetings/6th/meetingissue/{{this.id}}">🕵Review</a>
        </td>
			</tr>
		{{/each}}
	</tbody>
</table>
