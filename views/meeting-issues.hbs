{{> meeting-6th-tabs route="issue" }}
{{> search-meetingissue}}
<div class="mx-auto" style="width:90%;">
	{{> messages}}
</div>

<div class="text-primary text-secondary text-end mb-1 mx-auto fs-5" style="width:90%;">
    頁數<span id="current-page">{{pagination.currentPage}}</span>/{{pagination.totalPage}}
</div>

<table class="table-5th table-striped">
	<thead>
		<tr>
			<th><h1>會議日期</h1></th>
			<th><h1>併報主旨</h1></th>
			<th><h1>併報內容</h1></th>
		</tr>
	</thead>
	<tbody>
		{{#each issues}}
			<tr>
				<td class="AutoNewline">{{this.meeting_date}}</td>
				<td class="AutoNewline">{{this.name}}</td>
				<td class="AutoNewline">
          <a class="btn btn-outline-warning" href="/meetings/6th/meetingissue/{{this.id}}" target="_blank">🕵Review</a>
        </td>
			</tr>
		{{/each}}
	</tbody>
</table>

{{#if pagination.pages}}
	<nav class="mt-5 d-flex justify-content-center fs-4 " aria-label="page navigation">
		<ul class="pagination">
			<li class="page-item {{#ifMatch pagination.currentPage 1}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/6th/meetingissue?page={{pagination.prev}}&startDate={{startDate}}&endDate={{endDate}}&issue={{issue}}" aria-label="Previous">
					<span aria-hidden="true">&laquo;</span>
				</a>
			</li>
			{{#each pagination.pages}}
				{{#ifMatch this.page  ../pagination.currentPage}}
					<li class="page-item active"><a class="page-link" href="#">{{this.page }}</a></li>
				{{else}}
					<li class="page-item">
						<a class="page-link" href="/meetings/6th/meetingissue?page={{this.page }}&startDate={{../startDate}}&endDate={{../endDate}}&issue={{../issue}}">{{this.page }}</a>
					</li>
				{{/ifMatch}}
			{{/each}}
			<li class="page-item {{#ifMatch pagination.currentPage pagination.totalPage}}disabled{{/ifMatch}}">
				<a class="page-link" href="/meetings/6th/meetingissue?page={{pagination.next}}&startDate={{startDate}}&endDate={{endDate}}&issue={{issue}}" aria-label="Next">
					<span aria-hidden="true">&raquo;</span>
				</a>
			</li>
		</ul>
	</nav>
{{/if}}