<table class="table-5th table-striped">
	<tbody>
    <tr>
      <th class="AutoNewline">
        Subject
      </th>
      <td>
        {{ content.subject }}
      </td>
    </tr>
    <tr>
      <th>
        Date
      </th>
      <td>
        {{ content.date }}
      </td>
    </tr>
    <tr>
      <th>
        From
      </th>
      <td>
        {{ content.from.text }}
      </td>
    </tr>
    <tr>
      <th>
        To
      </th>
      <td>
        {{ content.to.text }}
      </td>
    </tr>
    <tr>
      <th>
        Content
      </th>
      <td>
        {{ content.text }}
      </td>
    </tr>
    </tr>
	</tbody>
</table>
