<form novalidate id="form" action="/meetings/7th" method="POST">
  <div class="row mt-5">
    <div class="">
      <div class="row align-items-center mb-5">
        <div class="col-3 text-danger">
          *Required Input
        </div>
        <h1 class="col-9 text-center text-secondary">
          新增會議內容
        </h1>
      </div>

      {{> messages}}
      
      <div class="row align-items-center mb-5 h3">
        <label for="name" class="col-3 text-white"><span class="text-danger">*</span>會議主旨:</label>
        <div class="col-9">
          <input id="content" name="name" type="text" class="form-control" value="" required>
          <div class="valid-feedback">很棒!</div>
          <div class="invalid-feedback">不能空白喔！</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="country" class="col-3 text-white"><span class="text-danger">*</span>國別:</label>
        <div class="col-9">
          <input id="country" name="country" type="text" class="form-control" value="" required>
          <div class="valid-feedback">很棒!</div>
          <div class="invalid-feedback">不能空白喔！</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="category" class="col-3 text-white"><span class="text-danger">*</span>會議類型:</label>
        <div class="col-9">
          <input id="category" name="category" type="text" class="form-control" value="" required>
          <div class="valid-feedback">很棒!</div>
          <div class="invalid-feedback">不能空白喔！</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="platform" class="col-3 text-white"><span class="text-danger">*</span>會議平台:</label>
        <div class="col-9">
          <input id="platform" name="platform" type="text" class="form-control" value="" required>
          <div class="valid-feedback">很棒!</div>
          <div class="invalid-feedback">不能空白喔！</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="link" class="col-3 text-white"><span class="text-danger">*</span>會議連結:</label>
        <div class="col-9">
          <input id="link" name="link" type="text" class="form-control" value="" required>
          <div class="valid-feedback">很棒!</div>
          <div class="invalid-feedback">不能空白喔！</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="password" class="col-3 text-white"><span class="text-danger">*</span>會議ID\密碼:</label>
        <div class="col-9">
          <input id="password" name="password" type="text" class="form-control" value="" required>
          <div class="valid-feedback">很棒!</div>
          <div class="invalid-feedback">不能空白喔！</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="meetingDate" class="col-3 text-white"><span class="text-danger">*</span>會議日期:</label>
        <div class="col-9">
          <input id="meetingDate" name="meetingDate" type="date" class="form-control" value="" required>
          <div class="valid-feedback">很棒!</div>
          <div class="invalid-feedback">不能空白喔！</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="acceptanceDate" class="col-3 text-white"><span class="text-danger">*</span>來料日期:</label>
        <div class="col-9">
          <input id="acceptanceDate" name="acceptanceDate" type="date" class="form-control" value="" required>
          <div class="valid-feedback">很棒!</div>
          <div class="invalid-feedback">不能空白喔！</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <label for="uuid" class="col-3 text-white"><span class="text-danger">*</span>報號/來源:</label>
        <div class="col-9">
          <input id="uuid" name="uuid" type="text" class="form-control" value="" required>
          <div class="valid-feedback">很棒!</div>
          <div class="invalid-feedback">不能空白喔！</div>
        </div>
      </div>

      <div class="row align-items-center mb-5 h3">
        <div class="col-3 ">
          <a class="btn btn-outline-success" href="javascript:history.back()">🔙上一頁</a>
        </div>
        <div class="col-9">
          <div class="d-flex justify-content-center">
            <button type="reset" class="btn btn-danger">重設</button>&nbsp
            <button id="submitButton" type="submit" class="btn btn-primary">送出</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</form>
