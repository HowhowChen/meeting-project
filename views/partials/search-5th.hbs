<div class="row">
  <div class="col-sm-8 m-auto">
    <form action="/meetings/5th" method="GET">
      <div class="row mt-5">
        <div class="col">
          <select class="rounded bg-light form-select" name="categoryId" onchange="form.submit()">
            <option selected>Category(All)</option>
            {{#each categories}}
              <option value="{{this.id}}" {{#ifMatch this.id ../categoryId}}selected{{/ifMatch}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="col">
          <select class="rounded bg-light form-select" name="platformId" onchange="form.submit()">
            <option selected>Platform(All)</option>
            {{#each platforms}}
              <option value="{{this.id}}" {{#ifMatch this.id ../platformId}}selected{{/ifMatch}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="col">
          <select class="rounded bg-light form-select" name="countryId" onchange="form.submit()">
            <option selected>Country(All)</option>
            {{#each countries}}
              <option value="{{this.id}}" {{#ifMatch this.id ../countryId}}selected{{/ifMatch}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>
        
