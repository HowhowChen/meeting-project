              <li class="nav-item">
                <a href="/admin/users" class="btn btn-outline-success me-2">Admin Control</a>
              </li>
            {{/ifMatch}}
            <li class="nav-item">
              <a href="/users/{{ user.id }}/edit" class="btn btn-outline-warning my-sm-0 me-2">Profile</a>
            </li>
            <li class="nav-item">
              <a href="/users/logout"><button class="btn btn-outline-danger my-sm-0 my-2">Logout</button></a>
            </li>
          </ul>
        </div>
      {{/if}}
    </div>
  </nav>
